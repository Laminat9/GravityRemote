# ==========================================
# GravityRemote Bot Configuration
# ==========================================

# Токен вашего Telegram-бота, полученный от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш числовой Telegram ID (узнать можно у бота @userinfobot или @myidbot)
ALLOWED_USER_ID=123456789

# Папка по умолчанию для сохранения файлов, отправляемых боту (опционально)
DEFAULT_DOWNLOAD_DIR=C:\Users\Username\Downloads\FromTelegram

# Прокси для работы бота БЕЗ системного VPN (опционально: socks5://127.0.0.1:10808 или http://127.0.0.1:8080)
# PROXY_URL=socks5://127.0.0.1:10808
